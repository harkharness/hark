{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Mother window + per-project windows",
  "windows": [
    "main",
    "proj-*",
    "hud"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "updater:default",
    "process:default"
  ]
}
